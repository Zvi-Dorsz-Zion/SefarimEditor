<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Sefarim.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- בלי ה-bundle: הספק נקבע ידנית (SqliteInit), כדי שהטעינה תעבוד גם כשהכול ארוז בקובץ EXE אחד -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
