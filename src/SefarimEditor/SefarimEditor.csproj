<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>SefarimEditor</AssemblyName>
    <RootNamespace>SefarimEditor</RootNamespace>
    <StartupObject>SefarimEditor.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>עורך הספרייה</Product>
    <AssemblyTitle>עורך הספרייה</AssemblyTitle>
    <Version>2.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <FodyGenerateXsd>false</FodyGenerateXsd>
    <!-- לא להעתיק את e_sqlite3.dll ליד ה-EXE: היא ארוזה בתוכו -->
    <SQLitePCLRawE_sqlite3Skip>true</SQLitePCLRawE_sqlite3Skip>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sefarim.Core\Sefarim.Core.csproj" />
    <Reference Include="System.Management" />
    <!-- אורז את כל הספריות (כולל e_sqlite3 המקורית) לתוך קובץ ה-EXE -->
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <Resource Include="app.ico" />
    <!-- ספריית SQLite המקורית נארזת בתוך ה-EXE ונשלפת בהפעלה (ראו NativeLoader) -->
    <EmbeddedResource Include="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\2.1.10\runtimes\win-x64\native\e_sqlite3.dll" LogicalName="SefarimEditor.e_sqlite3.dll" Link="e_sqlite3.dll" />
  </ItemGroup>

</Project>
